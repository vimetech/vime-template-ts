NODE_ENV=development
LOG_LEVEL=info

# --- Postgres -------------------------------------------------------------
# Superuser connection used ONLY by `pnpm db:bootstrap` to create roles + database (local/CI).
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/postgres
# Owner role: runs migrations, owns tables. Never used by the running app.
DATABASE_URL_OWNER=postgres://vime_owner:vime_owner@localhost:5432/vime
# App role: RLS enforced (no BYPASSRLS, not table owner). Used by api/worker for tenant work.
DATABASE_URL=postgres://vime_app:vime_app@localhost:5432/vime
# System role: BYPASSRLS. Used only via withSystem() (auth tables, webhook routing, job fan-out).
DATABASE_URL_SYSTEM=postgres://vime_system:vime_system@localhost:5432/vime

# --- API ------------------------------------------------------------------
# Listening port. When unset, PORT (set by Railway and most PaaS), then 4000. On Railway leave
# API_PORT unset so the API listens where the platform routes traffic.
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# Behind a reverse proxy you control (Railway: true), so rate limits see the client IP.
TRUST_PROXY=false
# Requests per minute and client IP (routes without their own limit). Default 600.
# RATE_LIMIT_GLOBAL=600
# Builds the API serves on its own origin (web app at /, API also under /api).
# In production it defaults to apps/web/dist next to the bundle; in development Vite serves it,
# so it stays unset.
# WEB_DIST_DIR=apps/web/dist
# >= 32 random chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# 32 random bytes, base64: `openssl rand -base64 32` (encrypts stored third-party credentials at rest;
# api and worker)
CREDENTIALS_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0wMTIzNDU2Nzg=
# Previous keys, comma-separated, decrypt-only after a rotation (api and worker; docs/deploy.md §11.1)
# CREDENTIALS_ENCRYPTION_KEYS_PREVIOUS=

# --- Object storage (S3-compatible: MinIO local, Cloudflare R2 prod) ------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=vime-media
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true
# Release only: origins allowed to PUT/GET photos on the bucket (comma-separated; default WEB_ORIGIN).
# S3_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Error reporting (api and worker) ---------------------------------------
# Sentry project DSN; unset: nothing is sent (docs/deploy.md §9.2).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- Release (node apps/api/dist/release.js, pre-deploy) --------------------
# First organization and its owner, created only when missing (never resets a password). All three
# required ones or none; the password needs 12+ characters. Never commit real values.
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_PASSWORD=
# BOOTSTRAP_OWNER_NAME=
# BOOTSTRAP_ORG_NAME=
# BOOTSTRAP_ORG_SLUG=
# BOOTSTRAP_ORG_TIMEZONE=America/Lima

# --- Integrations (never commit real values) -------------------------------
# Add each external service's variables here, with a comment on what breaks when unset.

# VIME support team: user ids (comma separated) that an organization's temporary support access
# lets in (Configuración → Acceso de soporte). Unset: nobody can use a grant.
# SUPPORT_USER_IDS=

# Platform console (ADR 0015): user ids (comma separated) of the platform administrators, who manage
# organizations' modules, sign-ups and suspensions. Unset: nobody sees the console.
# PLATFORM_ADMIN_USER_IDS=
# Release step 6: creates the platform administrator's account (no organization) and logs its id.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
