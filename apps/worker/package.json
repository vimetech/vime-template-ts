{
  "name": "@vime/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sentry/node": "10.75.2",
    "@vime/db": "workspace:*",
    "@vime/example": "workspace:*",
    "@vime/kernel": "workspace:*",
    "@vime/platform": "workspace:*",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vime/config": "workspace:*",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
